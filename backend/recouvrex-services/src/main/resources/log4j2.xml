<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <!-- Setting up log path and log file name -->
    <Properties>
        <Property name="LOG_PATH">./logs</Property>
        <Property name="LOG_FILE_NAME">application-log4j2</Property>
    </Properties>

    <!-- Setting up logging pattern for console logging -->
    <Appenders>
        <Console name="ConsoleOutput" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%style{%d{ISO8601}}{white} %highlight{%-5level} [%style{%t}{bright,yellow}] : %msg%n%throwable"
                    disableAnsi="false"/>
        </Console>

        <!-- Setting the filename and logging pattern for log file.
             Setting up a rolling policy with rolling done daily and when file size is 1KB for testing -->
        <RollingFile name="LogFile"
                     fileName="${LOG_PATH}/${LOG_FILE_NAME}.log"
                     filePattern="${LOG_PATH}/application-log4j2-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level : %msg%n</Pattern>
            </PatternLayout>
            <Policies>
                <SizeBasedTriggeringPolicy size="1 KB"/>
                <TimeBasedTriggeringPolicy />
            </Policies>
            <DefaultRolloverStrategy max="5"/>
        </RollingFile>
    </Appenders>

    <Loggers>

        <!-- Logging at INFO level -->
        <Root level="info">
            <AppenderRef ref="ConsoleOutput"/>
            <AppenderRef ref="LogFile"/>
        </Root>

        <!-- Logging at TRACE level for specific package -->
        <Logger name="com.log" level="trace" additivity="false">
            <AppenderRef ref="ConsoleOutput"/>
            <AppenderRef ref="LogFile"/>
        </Logger>

    </Loggers>

</Configuration>
